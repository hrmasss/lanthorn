<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- US-71: read access to videos only. No all-files access, no images, no audio. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Declaring it lets Android 14+ offer "select videos" (partial access) in the system prompt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Network streams the viewer opens (US-61, NF-8). Nothing in the app connects on its own. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
