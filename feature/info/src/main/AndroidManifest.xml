<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- File properties for any file, opened by PlayerIntents.showInfo(uri) (US-10.4). -->
        <activity
            android:name="app.player.feature.info.InfoActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="app.player.action.SHOW_INFO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>
    </application>
</manifest>
