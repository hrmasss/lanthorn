<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!--
            Lint checks this module alone and cannot see feature/player, hence MissingClass ignores.
            US-13.4: the player runs in its own task, so back from a player another app opened
            returns to that app, not to the library. Merged into feature/player's declaration;
            singleTask stays for PiP. autoRemoveFromRecents keeps a closed player out of recents.
        -->
        <activity
            android:name="app.player.feature.player.PlayerActivity"
            android:autoRemoveFromRecents="true"
            android:taskAffinity=""
            tools:ignore="MissingClass"
            tools:node="merge" />

        <!--
            US-13.1: audio files and the stream types file managers report, besides the player's
            own video/* filter. An alias so all of playback's "open with" entries live here.
        -->
        <activity-alias
            android:name="app.player.feature.playback.OpenFile"
            android:exported="true"
            android:targetActivity="app.player.feature.player.PlayerActivity"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/dash+xml" />
            </intent-filter>
        </activity-alias>

        <!--
            US-13.2: http and https media links. Turned on and off by "open media links"
            (OpenLinks.kt). Extensions are the library's scan list plus audio and stream playlists.
        -->
        <activity-alias
            android:name="app.player.feature.playback.OpenLink"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="app.player.feature.player.PlayerActivity"
            tools:ignore="MissingClass">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.m2ts" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.mpeg" />
                <data android:pathPattern=".*\\.mpg" />
                <data android:pathPattern=".*\\.mts" />
                <data android:pathPattern=".*\\.ogv" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\.mpd" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/dash+xml" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
